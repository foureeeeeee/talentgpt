# Anthropic API key — required for all AI features
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# People & Governance origin(s) allowed to hand off projects and frame TalentGPT
# Comma-separated, e.g. https://pg.example.com
VITE_PG_ORIGINS=

# Access code for the AI features. Required on Vercel (the API refuses requests
# without it); optional locally, where leaving it empty keeps the API open.
TALENTGPT_ACCESS_CODE=
